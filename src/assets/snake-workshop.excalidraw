      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 237570,
      "version": 1,
      "versionNonce": 107130,
      "isDeleted": false,
      "boundElements": null,
      "updated": 0,
      "created": null,
      "link": null,
      "locked": false,
      "index": null,
      "fontSize": 20,
      "fontFamily": 3,
      "text": "Duplicate a participant space as needed (Ctrl/Cmd + D). / Bei Bedarf ein Feld duplizieren (Strg/Cmd + D).",
      "originalText": "Duplicate a participant space as needed (Ctrl/Cmd + D). / Bei Bedarf ein Feld duplizieren (Strg/Cmd + D).",
