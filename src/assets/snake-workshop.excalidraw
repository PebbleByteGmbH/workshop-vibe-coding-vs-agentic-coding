    {
      "id": "snake-workshop-8",
      "type": "text",
      "x": 965,
      "y": 325,
      "width": 835,
      "height": 525.0,
      "angle": 0,
      "strokeColor": "#172033",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 63352,
      "version": 1,
      "versionNonce": 28568,
      "isDeleted": false,
      "boundElements": null,
      "updated": 0,
      "created": null,
      "link": null,
      "locked": false,
      "index": null,
      "fontSize": 21,
      "fontFamily": 3,
      "text": "Erstelle ein spielbares Snake-Spiel, das in meinem Webbrowser\nläuft.\n\nSteuere die Schlange mit den Pfeiltasten. Wenn sie Futter\nfrisst, wächst sie und erhält einen Punkt. Trifft sie eine Wand\noder ihren eigenen Körper, endet das Spiel.\n\nZeige den Punktestand, einen Start-Button, einen Neustart-Button\nund eine kurze Anleitung. Verwende ein klares, farbenfrohes\nDesign.\n\nErstelle das Spiel mit einfachem HTML, CSS und JavaScript im\nOrdner src. Es muss durch direktes Öffnen von src/index.html\nfunktionieren, ohne Pakete zu installieren oder einen Server zu\nstarten. Nutze keine externen Dienste und speichere keine\nSpielerdaten.\n\nErstelle die Dateien, prüfe, was du prüfen kannst, und erkläre\nmir in einfacher Sprache, wie ich das Spiel öffnen und spielen\nkann.",
      "originalText": "Erstelle ein spielbares Snake-Spiel, das in meinem Webbrowser\nläuft.\n\nSteuere die Schlange mit den Pfeiltasten. Wenn sie Futter\nfrisst, wächst sie und erhält einen Punkt. Trifft sie eine Wand\noder ihren eigenen Körper, endet das Spiel.\n\nZeige den Punktestand, einen Start-Button, einen Neustart-Button\nund eine kurze Anleitung. Verwende ein klares, farbenfrohes\nDesign.\n\nErstelle das Spiel mit einfachem HTML, CSS und JavaScript im\nOrdner src. Es muss durch direktes Öffnen von src/index.html\nfunktionieren, ohne Pakete zu installieren oder einen Server zu\nstarten. Nutze keine externen Dienste und speichere keine\nSpielerdaten.\n\nErstelle die Dateien, prüfe, was du prüfen kannst, und erkläre\nmir in einfacher Sprache, wie ich das Spiel öffnen und spielen\nkann.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
