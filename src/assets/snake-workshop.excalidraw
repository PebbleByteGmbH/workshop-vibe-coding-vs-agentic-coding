      "fontFamily": 3,
      "text": "IMPROVED VERSION / VERBESSERTE VERSION — 10 min",
      "originalText": "IMPROVED VERSION / VERBESSERTE VERSION — 10 min",
      "textAlign": "left",
      "verticalAlign": "top",
